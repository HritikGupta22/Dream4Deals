# Frontend Environment Configuration
# Copy this to .env.local (git-ignored) for development
# On Vercel, set these in Project Settings → Environment Variables

# ── API Configuration ─────────────────────────────────────────────────────────
# Development: http://localhost:3001 (local backend)
# Production: Render backend
NEXT_PUBLIC_API_URL=https://dream4deals.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Analytics & Monitoring ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://2772c432c3e290eeb65c9bbf6309407b@o4512035810377728.ingest.us.sentry.io/4512035826040832
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# ── Feature Flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_BETA=false
NEXT_PUBLIC_ENVIRONMENT=production

# Notes:
# - .env.local is git-ignored; never commit secrets
# - NEXT_PUBLIC_* variables are available in browser (never use secrets here)
# - On Vercel: Settings → Environment Variables → add each NEXT_PUBLIC_* key
# - NEXT_PUBLIC_API_URL must point to your deployed backend URL in production
# - Update this on every deployment to a new environment
