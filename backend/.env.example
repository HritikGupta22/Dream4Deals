# Copy this file to .env and replace placeholder values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001

# Database
# Local example: postgresql://postgres:password@localhost:5432/dream4deals
# Production example: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/dream4deals

# Session and security
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret
# Frontend origin allowed to call the API; omit only if the backend's default is appropriate.
CORS_ORIGIN=http://localhost:3001

# Meta / Instagram API (obtain from developers.facebook.com)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-long-lived-meta-access-token
META_INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id
# Must match the value configured in the Meta webhook settings.
META_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token

# Email (Mailgun)
# Obtain these values from your Mailgun account.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_FROM_EMAIL=noreply@your-mailgun-domain

# Logging and error tracking (optional)
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0

# Feature flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_AUTOMATION=true
ENABLE_AFFILIATE_TRACKING=true
