# Backend Environment Configuration
# Copy this file to .env and fill in your own values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL example: postgresql://postgres:password@localhost:5432/dream4deals
# Neon (production): postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dream4deals

# ── Session & Security ────────────────────────────────────────────────────────
SESSION_SECRET=your-random-secret-key-here-use-openssl-rand-base64-32
CORS_ORIGIN=http://localhost:3001

# ── Meta / Instagram API ──────────────────────────────────────────────────────
# Get these from https://developers.facebook.com
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_ACCESS_TOKEN=your-user-access-token
META_INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
META_VERIFY_TOKEN=your-webhook-verify-token

# ── Email (for password reset & verification) ─────────────────────────────────
# Example: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@dream4deals.com

# ── Logging & Error Tracking ──────────────────────────────────────────────────
# Sentry for production error tracking
SENTRY_DSN=https://your-sentry-url

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_AUTOMATION=true
ENABLE_AFFILIATE_TRACKING=true

# Notes:
# - Never commit .env file to git (it's in .gitignore)
# - Use strong random strings for SESSION_SECRET (openssl rand -base64 32)
# - DATABASE_URL: Use Neon (neon.tech) for production PostgreSQL
# - META_* credentials: Apply at developers.facebook.com, request app review for production
# - SENDGRID_API_KEY: Create account at sendgrid.com, generate API key
# - SENTRY_DSN: Sign up at sentry.io, create project, copy DSN
